@using CameraOperationsManagement.Models
@using CameraOperationsManagement.Models.Enums
@using CameraOperationsManagement.ViewModels.Common
@using CameraOperationsManagement.ViewModels.Visits

@model PagedResult<VisitListItemViewModel>

@{
    ViewData["Title"] = "Visits";

    var canManageVisits =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.Editor);
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Visits
        </h2>

        <p class="page-description">
            View and manage operational visits for site components.
        </p>
    </div>

    @if (canManageVisits)
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Record Visit
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<form id="visitFilterForm"
      method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">

            <!-- SEARCH -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Purpose, malfunction, repair, notes..." />

            </div>


            <!-- SITE -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Site
                </label>

                <select name="siteId"
                        asp-items="ViewBag.FilterSites"
                        class="form-select">

                    <option value="">
                        All sites
                    </option>

                </select>

            </div>


            <!-- COMPONENT TYPE -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Component Type
                </label>

                <select name="componentType"
                        class="form-select">

                    <option value="">
                        All component types
                    </option>

                    <option value="@((int)VisitComponentType.Recorder)"
                            selected="@(ViewBag.ComponentType?.ToString() == VisitComponentType.Recorder.ToString())">
                        Recorder
                    </option>

                    <option value="@((int)VisitComponentType.Switch)"
                            selected="@(ViewBag.ComponentType?.ToString() == VisitComponentType.Switch.ToString())">
                        Switch
                    </option>

                    <option value="@((int)VisitComponentType.Camera)"
                            selected="@(ViewBag.ComponentType?.ToString() == VisitComponentType.Camera.ToString())">
                        Camera
                    </option>

                </select>

            </div>


            <!-- WORKER -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Worker
                </label>

                <select name="workerId"
                        asp-items="ViewBag.FilterWorkers"
                        class="form-select">

                    <option value="">
                        All workers
                    </option>

                </select>

            </div>


            <!-- FROM DATE -->
            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    From Date
                </label>

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control" />

            </div>


            <!-- TO DATE -->
            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    To Date
                </label>

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control" />

            </div>


            <!-- FILTER ACTIONS -->
            <div class="col-xl-2 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply
                    </button>

                    <button type="button"
                            id="clearVisitFilters"
                            class="btn btn-outline-secondary">
                        Clear
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>


<div id="visitListContainer">

    <partial name="_VisitList"
             model="Model" />

</div>


@section Scripts
{
    <script>
        (() => {

            const form =
                document.getElementById("visitFilterForm");

            const container =
                document.getElementById("visitListContainer");

            const clearButton =
                document.getElementById("clearVisitFilters");


            async function loadVisits(url) {

                try {

                    const response =
                        await fetch(url, {
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        });

                    if (!response.ok) {
                        throw new Error(
                            "Failed to load visits.");
                    }

                    const html =
                        await response.text();

                    container.innerHTML =
                        html;

                    window.history.pushState(
                        {},
                        "",
                        url);
                }
                catch (error) {
                    console.error(error);
                }
            }


            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    const formData =
                        new FormData(form);

                    formData.set(
                        "page",
                        "1");

                    const query =
                        new URLSearchParams(
                            formData);

                    const url =
                        `${form.action}?${query.toString()}`;

                    loadVisits(url);
                });


            clearButton.addEventListener(
                "click",
                function () {

                    form.reset();

                    loadVisits(
                        form.action);
                });


            container.addEventListener(
                "click",
                function (event) {

                    const link =
                        event.target.closest(
                            "a[data-page-link]");

                    if (!link) {
                        return;
                    }

                    event.preventDefault();

                    loadVisits(
                        link.href);
                });


            window.addEventListener(
                "popstate",
                function () {
                    window.location.reload();
                });

        })();
    </script>
}
@model CameraOperationsManagement.ViewModels.Cameras.CameraFormViewModel

@{
    ViewData["Title"] = "Add Camera";
}

<div class="page-header">
    <div>
        <h2 class="page-heading">Add Camera</h2>
        <p class="page-description">
            Add a camera and assign it to a recorder.
        </p>
    </div>
</div>


<div class="app-card">
    <div class="app-card-body">

        <form asp-controller="Cameras"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>


            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           name="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>


                <div class="col-md-6">
                    <label asp-for="Type"
                           class="form-label">
                    </label>

                    <input asp-for="Type"
                           name="Type"
                           class="form-control" />

                    <span asp-validation-for="Type"
                          class="text-danger">
                    </span>
                </div>
                <div class="col-md-6">

                    <label asp-for="Environment"
                           class="form-label">
                    </label>

                    <select asp-for="Environment"
                            asp-items="Html.GetEnumSelectList<CameraOperationsManagement.Models.Enums.CameraEnvironment>()"
                            class="form-select">

                        <option value="">
                            Select environment
                        </option>

                    </select>

                    <span asp-validation-for="Environment"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">
                    <label asp-for="Brand"
                           class="form-label">
                    </label>

                    <input asp-for="Brand"
                           name="Brand"
                           class="form-control" />
                </div>


                <div class="col-md-6">
                    <label asp-for="Model"
                           class="form-label">
                    </label>

                    <input asp-for="Model"
                           name="Model"
                           class="form-control" />
                </div>


                <div class="col-md-6">
                    <label asp-for="SerialNumber"
                           class="form-label">
                    </label>

                    <input asp-for="SerialNumber"
                           name="SerialNumber"
                           class="form-control" />
                </div>


                <div class="col-md-6">
                    <label asp-for="IpAddress"
                           class="form-label">
                    </label>

                    <input asp-for="IpAddress"
                           name="IpAddress"
                           class="form-control" />
                </div>


                <div class="col-md-6">
                    <label asp-for="RecorderId"
                           class="form-label">
                    </label>

                    <select asp-for="RecorderId"
                            name="RecorderId"
                            asp-items="ViewBag.Recorders"
                            class="form-select"
                            id="recorderSelect">

                        <option value="0">
                            Select recorder
                        </option>

                    </select>

                    <span asp-validation-for="RecorderId"
                          class="text-danger">
                    </span>
                </div>


                <div class="col-md-6">
                    <label asp-for="NetworkSwitchId"
                           class="form-label">
                    </label>

                    <select asp-for="NetworkSwitchId"
                            name="NetworkSwitchId"
                            asp-items="ViewBag.Switches"
                            class="form-select"
                            id="switchSelect">

                        <option value="">
                            No switch
                        </option>

                    </select>

                    <span asp-validation-for="NetworkSwitchId"
                          class="text-danger">
                    </span>
                </div>


                <div class="col-md-8">
                    <label asp-for="InstallationLocation"
                           class="form-label">
                    </label>

                    <input asp-for="InstallationLocation"
                           name="InstallationLocation"
                           class="form-control" />

                    <span asp-validation-for="InstallationLocation"
                          class="text-danger">
                    </span>
                </div>


                <div class="col-md-4">
                    <label asp-for="InstallationDate"
                           class="form-label">
                    </label>

                    <input asp-for="InstallationDate"
                           name="InstallationDate"
                           type="date"
                           class="form-control" />
                </div>


                <div class="col-12">
                    <label asp-for="Notes"
                           class="form-label">
                    </label>

                    <textarea asp-for="Notes"
                              name="Notes"
                              class="form-control"
                              rows="4"></textarea>
                </div>

            </div>


            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Add Camera
                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const recorderSelect =
                document.getElementById("recorderSelect");

            const switchSelect =
                document.getElementById("switchSelect");


            recorderSelect.addEventListener("change", async function () {

                const recorderId = this.value;

                switchSelect.innerHTML =
                    '<option value="">No switch</option>';


                if (!recorderId || recorderId === "0") {
                    return;
                }


                const url =
                    '@Url.Action("GetSwitchesByRecorder", "Cameras")'
                    + '?recorderId='
                    + encodeURIComponent(recorderId);


                const response = await fetch(url);

                if (!response.ok) {
                    return;
                }


                const switches = await response.json();


                switches.forEach(item => {

                    const option =
                        document.createElement("option");

                    option.value = item.id;
                    option.textContent = item.name;

                    switchSelect.appendChild(option);
                });

            });

        });
    </script>
}
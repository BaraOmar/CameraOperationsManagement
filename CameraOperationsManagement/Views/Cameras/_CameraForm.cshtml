@model CameraOperationsManagement.ViewModels.Cameras.CameraFormViewModel

<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>


<div class="row g-3">

    <div class="col-md-6">

        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="Type"
               class="form-label">
        </label>

        <input asp-for="Type"
               class="form-control" />

        <span asp-validation-for="Type"
              class="text-danger">
        </span>

    </div>
    <div class="col-md-6">

        <label asp-for="Environment"
               class="form-label">
        </label>

        <select asp-for="Environment"
                asp-items="Html.GetEnumSelectList<CameraOperationsManagement.Models.Enums.CameraEnvironment>()"
                class="form-select">

            <option value="">
                Select environment
            </option>

        </select>

        <span asp-validation-for="Environment"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-6">

        <label asp-for="Brand"
               class="form-label">
        </label>

        <input asp-for="Brand"
               class="form-control" />

        <span asp-validation-for="Brand"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="Model"
               class="form-label">
        </label>

        <input asp-for="Model"
               class="form-control" />

        <span asp-validation-for="Model"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="SerialNumber"
               class="form-label">
        </label>

        <input asp-for="SerialNumber"
               class="form-control" />

        <span asp-validation-for="SerialNumber"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="IpAddress"
               class="form-label">
        </label>

        <input asp-for="IpAddress"
               class="form-control" />

        <span asp-validation-for="IpAddress"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="RecorderId"
               class="form-label">
        </label>

        <select asp-for="RecorderId"
                asp-items="ViewBag.Recorders"
                class="form-select"
                id="recorderSelect">

            <option value="0">
                Select recorder
            </option>

        </select>

        <span asp-validation-for="RecorderId"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="NetworkSwitchId"
               class="form-label">
        </label>

        <select asp-for="NetworkSwitchId"
                asp-items="ViewBag.Switches"
                class="form-select"
                id="switchSelect">

            <option value="">
                No switch
            </option>

        </select>

        <span asp-validation-for="NetworkSwitchId"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-6">

        <label asp-for="NetworkSwitchPortId"
               class="form-label">
        </label>

        <select asp-for="NetworkSwitchPortId"
                asp-items="ViewBag.SwitchPorts"
                class="form-select"
                id="portSelect">

            <option value="">
                Select port
            </option>

        </select>

        <span asp-validation-for="NetworkSwitchPortId"
              class="text-danger">
        </span>

    </div>
    <div class="col-md-8">

        <label asp-for="InstallationLocation"
               class="form-label">
        </label>

        <input asp-for="InstallationLocation"
               class="form-control" />

        <span asp-validation-for="InstallationLocation"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-4">

        <label asp-for="InstallationDate"
               class="form-label">
        </label>

        <input asp-for="InstallationDate"
               class="form-control"
               type="date" />

        <span asp-validation-for="InstallationDate"
              class="text-danger">
        </span>

    </div>


    <div class="col-12">

        <label asp-for="Notes"
               class="form-label">
        </label>

        <textarea asp-for="Notes"
                  class="form-control"
                  rows="4"></textarea>

        <span asp-validation-for="Notes"
              class="text-danger">
        </span>

    </div>

</div>
@model CameraOperationsManagement.ViewModels.Cameras.CameraFormViewModel

@{
    ViewData["Title"] = "Edit Camera";
}

<div class="page-header">
    <div class="d-flex align-items-start gap-3">

        <partial name="_BackButton" />
    <div>
        <h2 class="page-heading">Edit Camera</h2>

        <p class="page-description">
            Update the camera information.
        </p>
    </div>
    </div>
</div>


<div class="app-card">

    <div class="app-card-body">

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <input asp-for="Id"
                   type="hidden" />

            <partial name="_CameraForm"
                     model="Model" />

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const recorderSelect =
                    document.getElementById("recorderSelect");

                const switchSelect =
                    document.getElementById("switchSelect");

                const portSelect =
                    document.getElementById("portSelect");

                const currentCameraId =
                    '@Model.Id';


                // ==========================================
                // RECORDER CHANGED
                // ==========================================
                recorderSelect.addEventListener(
                    "change",
                    async function () {

                        const recorderId =
                            this.value;


                        switchSelect.innerHTML =
                            '<option value="">No switch</option>';

                        portSelect.innerHTML =
                            '<option value="">Select port</option>';


                        if (!recorderId ||
                            recorderId === "0") {
                            return;
                        }


                        const url =
                            '@Url.Action("GetSwitchesByRecorder", "Cameras")'
                            + '?recorderId='
                            + encodeURIComponent(recorderId);


                        try {

                            const response =
                                await fetch(url);


                            if (!response.ok) {
                                return;
                            }


                            const switches =
                                await response.json();


                            switches.forEach(item => {

                                const option =
                                    document.createElement("option");

                                option.value =
                                    item.id;

                                option.textContent =
                                    item.name;

                                switchSelect
                                    .appendChild(option);
                            });
                        }
                        catch (error) {

                            console.error(
                                "Could not load switches.",
                                error);
                        }
                    });


                // ==========================================
                // SWITCH CHANGED
                // ==========================================
                switchSelect.addEventListener(
                    "change",
                    async function () {

                        const switchId =
                            this.value;


                        portSelect.innerHTML =
                            '<option value="">Select port</option>';


                        if (!switchId) {
                            return;
                        }


                        const url =
                            '@Url.Action("GetAvailablePorts", "Cameras")'
                            + '?switchId='
                            + encodeURIComponent(switchId)
                            + '&currentCameraId='
                            + encodeURIComponent(currentCameraId);


                        try {

                            const response =
                                await fetch(url);


                            if (!response.ok) {
                                return;
                            }


                            const ports =
                                await response.json();


                            ports.forEach(item => {

                                const option =
                                    document.createElement("option");

                                option.value =
                                    item.id;

                                option.textContent =
                                    item.text;

                                portSelect
                                    .appendChild(option);
                            });
                        }
                        catch (error) {

                            console.error(
                                "Could not load ports.",
                                error);
                        }
                    });

            });
    </script>
}
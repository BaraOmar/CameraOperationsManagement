@using CameraOperationsManagement.Models
@using CameraOperationsManagement.ViewModels.Common
@using CameraOperationsManagement.ViewModels.Cameras

@model PagedResult<CameraListItemViewModel>

@{
    ViewData["Title"] = "Cameras";

    var canManageInfrastructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var isAdmin =
        User.IsInRole(AppRoles.Admin);
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Cameras
        </h2>

        <p class="page-description">
            View and manage cameras across all operational sites.
        </p>
    </div>


    <div class="d-flex gap-2">

        <a asp-action="ExportPdf"
               id="cameraPdfLink"
               target="_blank"
               class="btn btn-outline-secondary">
            View PDF
        </a>


        @if (canManageInfrastructure)
        {
            <a asp-action="Create"
                   class="btn btn-primary">
                Add Camera
            </a>
        }

    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<form id="cameraFilterForm"
      method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">


            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Name, brand, model, IP, location..." />

            </div>


            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Site
                </label>

                <select name="siteId"
                        asp-items="ViewBag.FilterSites"
                        class="form-select">

                    <option value="">
                        All sites
                    </option>

                </select>

            </div>


            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Recorder
                </label>

                <select name="recorderId"
                        asp-items="ViewBag.FilterRecorders"
                        class="form-select">

                    <option value="">
                        All recorders
                    </option>

                </select>

            </div>


            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    Camera Type
                </label>

                <select name="cameraType"
                        asp-items="ViewBag.FilterTypes"
                        class="form-select">

                    <option value="">
                        All types
                    </option>

                </select>

            </div>


            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    Switch
                </label>

                <select name="switchId"
                        asp-items="ViewBag.FilterSwitches"
                        class="form-select">

                    <option value="">
                        All switches
                    </option>

                </select>

            </div>


            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Status == null)">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(ViewBag.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(ViewBag.Status == "inactive")">
                        Inactive
                    </option>

                </select>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>

                    <button type="button"
                            id="clearCameraFilters"
                            class="btn btn-outline-secondary">
                        Clear
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>


<div id="cameraListContainer">

    <partial name="_CameraList"
             model="Model" />

</div>


@section Scripts
{
    <script>
        (() => {

            const form =
                document.getElementById("cameraFilterForm");

            const container =
                document.getElementById("cameraListContainer");

            const clearButton =
                document.getElementById("clearCameraFilters");

                const pdfLink =
        document.getElementById("cameraPdfLink");
                function updatePdfLink() {

            const formData =
                new FormData(form);

            // PDF should export all matching records,
            // not only the current pagination page.
            formData.delete("page");

            const query =
                new URLSearchParams(formData);

            pdfLink.href =
                `/Cameras/ExportPdf?${query.toString()}`;
        }

            async function loadCameras(url) {

                try {

                    const response =
                        await fetch(url, {
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        });


                    if (!response.ok) {
                        throw new Error(
                            "Failed to load cameras.");
                    }


                    const html =
                        await response.text();


                    container.innerHTML =
                        html;


                    window.history.pushState(
                        {},
                        "",
                        url);

                }
                catch (error) {

                    console.error(error);

                }
            }


            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();


                    const formData =
                        new FormData(form);


                    formData.set(
                        "page",
                        "1");


                    const query =
                        new URLSearchParams(
                            formData);


                    const url =
                        `${form.action}?${query.toString()}`;

                    updatePdfLink();

                    loadCameras(url);
                });


        clearButton.addEventListener(
            "click",
            function () {

                form.reset();

                updatePdfLink();

                loadCameras(
                    form.action);
            });


            container.addEventListener(
                "click",
                function (event) {

                    const link =
                        event.target.closest(
                            "a[data-page-link]");


                    if (!link) {
                        return;
                    }


                    event.preventDefault();


                    loadCameras(
                        link.href);
                });


            window.addEventListener(
                "popstate",
                function () {

                    window.location.reload();

                });
                updatePdfLink();
        })();
    </script>
}
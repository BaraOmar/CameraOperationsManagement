@model IEnumerable<CameraOperationsManagement.ViewModels.Cameras.CameraListItemViewModel>

@{
    ViewData["Title"] = "Cameras";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">Cameras</h2>

        <p class="page-description">
            View and manage cameras across all operational sites.
        </p>
    </div>

    @if (User.IsInRole("Admin") ||
         User.IsInRole("Editor"))
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Add Camera
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<div class="app-card">

    @if (!Model.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No cameras have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Camera</th>
                        <th>Site</th>
                        <th>Recorder</th>
                        <th>Type</th>
                        <th>IP Address</th>
                        <th>Location</th>
                        <th>Switch</th>
                        <th>Status</th>

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Editor"))
                        {
                            <th class="text-end">
                                Actions
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @foreach (var camera in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @camera.Name
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(camera.Brand) ||
                                     !string.IsNullOrWhiteSpace(camera.Model))
                                {
                                    <div class="text-muted small">
                                        @camera.Brand @camera.Model
                                    </div>
                                }
                            </td>


                            <td>
                                <div>
                                    @camera.SiteName
                                </div>

                                <small class="text-muted">
                                    @camera.SiteId
                                </small>
                            </td>


                            <td>
                                @camera.RecorderName
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(camera.Type))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @camera.Type
                                }
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(camera.IpAddress))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @camera.IpAddress
                                }
                            </td>


                            <td>
                                @camera.InstallationLocation
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    camera.NetworkSwitchName))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @camera.NetworkSwitchName
                                }
                            </td>


                            <td>
                                @if (camera.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>


                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Editor"))
                            {
                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="History"
                                               asp-route-id="@camera.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            History
                                        </a>
                                        <a asp-action="Edit"
                                               asp-route-id="@camera.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@camera.Id"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    @(camera.IsActive
                                                        ? "Deactivate"
                                                        : "Activate")
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
@model IEnumerable<CameraOperationsManagement.ViewModels.Cameras.CameraListItemViewModel>

@{
    ViewData["Title"] = "Cameras";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">Cameras</h2>

        <p class="page-description">
            View and manage cameras across all operational sites.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="ExportPdf"
               asp-route-search="@ViewBag.Search"
               asp-route-siteId="@Context.Request.Query["siteId"]"
               asp-route-recorderId="@Context.Request.Query["recorderId"]"
               asp-route-cameraType="@Context.Request.Query["cameraType"]"
               asp-route-switchId="@Context.Request.Query["switchId"]"
               asp-route-status="@ViewBag.Status"
               target="_blank"
               class="btn btn-outline-secondary">
            View PDF
        </a>


        @if (User.IsInRole("Admin") ||
             User.IsInRole("Editor"))
        {
            <a asp-action="Create"
                   class="btn btn-primary">
                Add Camera
            </a>
        }

    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">


            <!-- SEARCH -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Name, brand, model, IP, location..." />

            </div>


            <!-- SITE -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Site
                </label>

                <select name="siteId"
                        asp-items="ViewBag.FilterSites"
                        class="form-select">

                    <option value="">
                        All sites
                    </option>

                </select>

            </div>


            <!-- RECORDER -->
            <div class="col-xl-4 col-md-6">

                <label class="form-label">
                    Recorder
                </label>

                <select name="recorderId"
                        asp-items="ViewBag.FilterRecorders"
                        class="form-select">

                    <option value="">
                        All recorders
                    </option>

                </select>

            </div>


            <!-- TYPE -->
            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    Camera Type
                </label>

                <select name="cameraType"
                        asp-items="ViewBag.FilterTypes"
                        class="form-select">

                    <option value="">
                        All types
                    </option>

                </select>

            </div>


            <!-- SWITCH -->
            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    Switch
                </label>

                <select name="switchId"
                        asp-items="ViewBag.FilterSwitches"
                        class="form-select">

                    <option value="">
                        All switches
                    </option>

                </select>

            </div>


            <!-- STATUS -->
            <div class="col-xl-3 col-md-6">

                <label class="form-label">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Status == null)">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(ViewBag.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(ViewBag.Status == "inactive")">
                        Inactive
                    </option>

                </select>

            </div>


            <!-- ACTIONS -->
            <div class="col-xl-3 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>
<div class="app-card">

    @if (!Model.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No cameras have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Camera</th>
                        <th>Site</th>
                        <th>Recorder</th>
                        <th>Type</th>
                        <th>IP Address</th>
                        <th>Location</th>
                        <th>Switch</th>
                        <th>Status</th>

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Editor"))
                        {
                            <th class="text-end">
                                Actions
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @foreach (var camera in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @camera.Name
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(camera.Brand) ||
                                     !string.IsNullOrWhiteSpace(camera.Model))
                                {
                                    <div class="text-muted small">
                                        @camera.Brand @camera.Model
                                    </div>
                                }
                            </td>


                            <td>
                                <div>
                                    @camera.SiteName
                                </div>

                                <small class="text-muted">
                                    @camera.SiteId
                                </small>
                            </td>


                            <td>
                                @camera.RecorderName
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(camera.Type))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @camera.Type
                                }
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(camera.IpAddress))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @camera.IpAddress
                                }
                            </td>


                            <td>
                                @camera.InstallationLocation
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    camera.NetworkSwitchName))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @camera.NetworkSwitchName
                                }
                            </td>


                            <td>
                                @if (camera.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>


                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Editor"))
                            {
                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="History"
                                               asp-route-id="@camera.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            History
                                        </a>
                                        <a asp-action="Edit"
                                               asp-route-id="@camera.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@camera.Id"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    @(camera.IsActive
                                                        ? "Deactivate"
                                                        : "Activate")
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
@model CameraOperationsManagement.ViewModels.Users.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Create User
        </h2>

        <p class="page-description">
            Create a new system user and assign their access role.
        </p>
    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">
        Back to Users
    </a>

</div>


<div class="app-card">

    <div class="app-card-header">
        <strong>User Information</strong>
    </div>

    <div class="app-card-body">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">

                <div class="col-md-4">

                    <label asp-for="FirstName"
                           class="form-label">
                    </label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="SecondName"
                           class="form-label">
                    </label>

                    <input asp-for="SecondName"
                           class="form-control" />

                    <span asp-validation-for="SecondName"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="LastName"
                           class="form-label">
                    </label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Password"
                           class="form-label">
                    </label>

                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="mt-4">

                <div class="mb-2">
                    <h3 class="h6 mb-1">
                        Access Role
                    </h3>

                    <p class="text-muted small mb-0">
                        The selected role determines which pages,
                        actions and reports this user can access.
                    </p>
                </div>


                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="Role"
                               class="form-label">
                            Role
                        </label>

                        <select asp-for="Role"
                                asp-items="ViewBag.Roles"
                                class="form-select">

                            <option value="">
                                Select a role
                            </option>

                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Create User
                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
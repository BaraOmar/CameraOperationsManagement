@using CameraOperationsManagement.Models
@using CameraOperationsManagement.Models.Enums
@using CameraOperationsManagement.ViewModels.Common
@using CameraOperationsManagement.ViewModels.Recorders

@model PagedResult<RecorderListItemViewModel>

@{
    ViewData["Title"] = "Recorders";

    var canManageInfrastructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var isAdmin =
        User.IsInRole(AppRoles.Admin);
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Recorders
        </h2>

        <p class="page-description">
            View and manage NVR and DVR recorders.
        </p>
    </div>

    @if (canManageInfrastructure)
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Add Recorder
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<form id="recorderFilterForm"
      method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">

            <div class="col-xl-3 col-md-6">
                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Recorder name..." />
            </div>


            <div class="col-xl-3 col-md-6">
                <label class="form-label">
                    Site
                </label>

                <select name="siteId"
                        asp-items="ViewBag.FilterSites"
                        class="form-select">

                    <option value="">
                        All sites
                    </option>

                </select>
            </div>


            <div class="col-xl-2 col-md-6">
                <label class="form-label">
                    Type
                </label>

                <select name="type"
                        class="form-select">

                    <option value="">
                        All types
                    </option>

                    <option value="@((int)RecorderType.NVR)"
                            selected="@(ViewBag.Type?.ToString() == RecorderType.NVR.ToString())">
                        NVR
                    </option>

                    <option value="@((int)RecorderType.DVR)"
                            selected="@(ViewBag.Type?.ToString() == RecorderType.DVR.ToString())">
                        DVR
                    </option>

                </select>
            </div>


            <div class="col-xl-2 col-md-6">
                <label class="form-label">
                    Switch
                </label>

                <select name="switchId"
                        asp-items="ViewBag.FilterSwitches"
                        class="form-select">

                    <option value="">
                        All switches
                    </option>

                </select>
            </div>


            <div class="col-xl-2 col-md-6">
                <label class="form-label">
                    Storage
                </label>

                <select name="storage"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Storage == null)">
                        All
                    </option>

                    <option value="yes"
                            selected="@(ViewBag.Storage == "yes")">
                        Has Storage
                    </option>

                    <option value="no"
                            selected="@(ViewBag.Storage == "no")">
                        No Storage
                    </option>

                </select>
            </div>


            <div class="col-xl-2 col-md-6">
                <label class="form-label">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Status == null)">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(ViewBag.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(ViewBag.Status == "inactive")">
                        Inactive
                    </option>

                </select>
            </div>


            <div class="col-xl-3 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>

                    <button type="button"
                            id="clearRecorderFilters"
                            class="btn btn-outline-secondary">
                        Clear
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>


<div id="recorderListContainer">

    <partial name="_RecorderList"
             model="Model" />

</div>


@section Scripts
{
    <script>
        (() => {

            const form =
                document.getElementById("recorderFilterForm");

            const container =
                document.getElementById("recorderListContainer");

            const clearButton =
                document.getElementById("clearRecorderFilters");


            async function loadRecorders(url) {

                try {

                    const response =
                        await fetch(url, {
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        });

                    if (!response.ok) {
                        throw new Error(
                            "Failed to load recorders.");
                    }

                    const html =
                        await response.text();

                    container.innerHTML =
                        html;

                    window.history.pushState(
                        {},
                        "",
                        url);
                }
                catch (error) {
                    console.error(error);
                }
            }


            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    const formData =
                        new FormData(form);

                    formData.set(
                        "page",
                        "1");

                    const query =
                        new URLSearchParams(
                            formData);

                    const url =
                        `${form.action}?${query.toString()}`;

                    loadRecorders(url);
                });


            clearButton.addEventListener(
                "click",
                function () {

                    form.reset();

                    loadRecorders(
                        form.action);
                });


            container.addEventListener(
                "click",
                function (event) {

                    const link =
                        event.target.closest(
                            "a[data-page-link]");

                    if (!link) {
                        return;
                    }

                    event.preventDefault();

                    loadRecorders(
                        link.href);
                });


            window.addEventListener(
                "popstate",
                function () {
                    window.location.reload();
                });

        })();
    </script>
}
@using CameraOperationsManagement.Models
@using CameraOperationsManagement.ViewModels.Common
@using CameraOperationsManagement.ViewModels.NetworkSwitches

@model PagedResult<NetworkSwitchListItemViewModel>

@{
    ViewData["Title"] = "Network Switches";

    var canManageInfrastructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var isAdmin =
        User.IsInRole(AppRoles.Admin);
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Network Switches
        </h2>

        <p class="page-description">
            View and manage network switches assigned to sites.
        </p>
    </div>

    @if (canManageInfrastructure)
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Add Switch
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<form id="switchFilterForm"
      method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">

            <div class="col-lg-4 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Switch name..." />

            </div>


            <div class="col-lg-4 col-md-6">

                <label class="form-label">
                    Site
                </label>

                <select name="siteId"
                        asp-items="ViewBag.FilterSites"
                        class="form-select">

                    <option value="">
                        All sites
                    </option>

                </select>

            </div>


            <div class="col-lg-2 col-md-6">

                <label class="form-label">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Status == null)">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(ViewBag.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(ViewBag.Status == "inactive")">
                        Inactive
                    </option>

                </select>

            </div>


            <div class="col-lg-2 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply
                    </button>

                    <button type="button"
                            id="clearSwitchFilters"
                            class="btn btn-outline-secondary">
                        Clear
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>


<div id="switchListContainer">

    <partial name="_NetworkSwitchList"
             model="Model" />

</div>


@section Scripts
{
    <script>
        (() => {

            const form =
                document.getElementById("switchFilterForm");

            const container =
                document.getElementById("switchListContainer");

            const clearButton =
                document.getElementById("clearSwitchFilters");


            async function loadSwitches(url) {

                try {

                    const response =
                        await fetch(url, {
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        });

                    if (!response.ok) {
                        throw new Error(
                            "Failed to load switches.");
                    }

                    const html =
                        await response.text();

                    container.innerHTML =
                        html;

                    window.history.pushState(
                        {},
                        "",
                        url);
                }
                catch (error) {
                    console.error(error);
                }
            }


            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    const formData =
                        new FormData(form);

                    formData.set(
                        "page",
                        "1");

                    const query =
                        new URLSearchParams(
                            formData);

                    const url =
                        `${form.action}?${query.toString()}`;

                    loadSwitches(url);
                });


            clearButton.addEventListener(
                "click",
                function () {

                    form.reset();

                    loadSwitches(
                        form.action);
                });


            container.addEventListener(
                "click",
                function (event) {

                    const link =
                        event.target.closest(
                            "a[data-page-link]");

                    if (!link) {
                        return;
                    }

                    event.preventDefault();

                    loadSwitches(
                        link.href);
                });


            window.addEventListener(
                "popstate",
                function () {
                    window.location.reload();
                });

        })();
    </script>
}
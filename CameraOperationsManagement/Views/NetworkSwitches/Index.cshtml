@model IEnumerable<CameraOperationsManagement.ViewModels.NetworkSwitches.NetworkSwitchListItemViewModel>

@{
    ViewData["Title"] = "Network Switches";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Network Switches
        </h2>

        <p class="page-description">
            View and manage network switches assigned to sites.
        </p>
    </div>

    @if (User.IsInRole("Admin") ||
         User.IsInRole("Editor"))
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Add Switch
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<div class="app-card">

    @if (!Model.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No network switches have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Site</th>
                        <th>Status</th>

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Editor"))
                        {
                            <th class="text-end">
                                Actions
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @item.Name
                                </strong>
                            </td>

                            <td>
                                <div>
                                    @item.SiteName
                                </div>

                                <small class="text-muted">
                                    @item.SiteId
                                </small>
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>


                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Editor"))
                            {
                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">

                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@item.Id"
                                                  method="post">

                                                @if (item.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">
                                                        Activate
                                                    </button>
                                                }

                                            </form>
                                        }

                                    </div>

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
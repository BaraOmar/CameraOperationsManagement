@model CameraOperationsManagement.ViewModels.NetworkSwitches.NetworkSwitchFormViewModel

@{
    ViewData["Title"] = "Edit Network Switch";
}

<div class="page-header">
    <div class="d-flex align-items-start gap-3">

        <partial name="_BackButton" />
    <div>
        <h2 class="page-heading">
            Edit Network Switch
        </h2>

        <p class="page-description">
            Update the network switch information.
        </p>
    </div>
    </div>
</div>


<div class="app-card">

    <div class="app-card-body">

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <input asp-for="Id"
                   type="hidden" />


            <partial name="_NetworkSwitchForm"
                     model="Model" />

            @if (Model.Ports.Any())
            {
                <hr class="my-4" />

                <div class="mb-3">

                    <h5 class="mb-1">
                        Switch Ports
                    </h5>

                    <p class="text-muted mb-0">
                        Manage the state of unused ports.
                        Used ports are controlled by their connected cameras.
                    </p>

                </div>


                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Port</th>
                                <th>Status</th>
                                <th>Connected Camera</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (var i = 0;
                                  i < Model.Ports.Count;
                                  i++)
                            {
                                var port =
                                    Model.Ports[i];

                                <tr>

                                    <td>
                                        <strong>
                                            Port @port.PortNumber
                                        </strong>

                                        <input asp-for="Ports[i].Id"
                                               type="hidden" />

                                        <input asp-for="Ports[i].PortNumber"
                                               type="hidden" />
                                    </td>


                                    <td>

                                        @if (port.Status ==
                                            CameraOperationsManagement.Models.Enums.SwitchPortStatus.Used)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">
                                                Used
                                            </span>
                                        }
                                        else
                                        {
                                            <select asp-for="Ports[i].Status"
                                                    class="form-select form-select-sm">

                                                <option value="1">
                                                    Available
                                                </option>

                                                <option value="3">
                                                    Out of Service
                                                </option>

                                            </select>
                                        }

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            port.CameraName))
                                        {
                                            @port.CameraName
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
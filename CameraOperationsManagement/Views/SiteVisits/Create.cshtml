@model CameraOperationsManagement.ViewModels.SiteVisits.SiteVisitFormViewModel

@{
    ViewData["Title"] = "Record Site Visit";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Record Site Visit
        </h2>

        <p class="page-description">
            Record a site visit and the workers who participated.
        </p>
    </div>

</div>


<div class="app-card">

    <div class="app-card-body">

        <form asp-controller="SiteVisits"
              asp-action="Create"
              method="post">

            <partial name="_SiteVisitForm"
                     model="Model" />


            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Record Visit
                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@using CameraOperationsManagement.Models

@model CameraOperationsManagement.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var canManageVisits =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.Editor);

    var canViewWorkers =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager) ||
        User.IsInRole(AppRoles.Editor);

    var statColumnClass =
        canViewWorkers
            ? "col-sm-6 col-xl-3"
            : "col-sm-6 col-xl-4";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Dashboard
        </h2>

        <p class="page-description">
            Overview of current infrastructure and recent operational activity.
        </p>
    </div>


    @if (canManageVisits)
    {
        <a asp-controller="Visits"
               asp-action="Create"
               class="btn btn-primary">
            Record Visit
        </a>
    }

</div>


<!-- SUMMARY CARDS -->
<div class="row g-3 mb-4">


    <!-- ACTIVE SITES -->
    <div class="@statColumnClass">

        <div class="dashboard-stat-card">

            <div class="dashboard-stat-body">

                <div class="dashboard-stat-label">
                    ACTIVE SITES
                </div>

                <div class="dashboard-stat-value">
                    @Model.ActiveSites
                </div>

                <div class="dashboard-stat-description">
                    Operational locations
                </div>

                <a asp-controller="Sites"
                       asp-action="Index"
                       class="dashboard-stat-link">

                    View sites

                    <span class="arrow"
                          aria-hidden="true">
                        →
                    </span>

                </a>

            </div>

        </div>

    </div>



    <!-- ACTIVE CAMERAS -->
    <div class="@statColumnClass">

        <div class="dashboard-stat-card">

            <div class="dashboard-stat-body">

                <div class="dashboard-stat-label">
                    ACTIVE CAMERAS
                </div>

                <div class="dashboard-stat-value">
                    @Model.ActiveCameras
                </div>

                <div class="dashboard-stat-description">
                    Cameras currently in service
                </div>

                <a asp-controller="Cameras"
                       asp-action="Index"
                       class="dashboard-stat-link">

                    View cameras

                    <span class="arrow"
                          aria-hidden="true">
                        →
                    </span>

                </a>

            </div>

        </div>

    </div>



    <!-- ACTIVE WORKERS -->
    @if (canViewWorkers)
    {
        <div class="@statColumnClass">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-body">

                    <div class="dashboard-stat-label">
                        ACTIVE WORKERS
                    </div>

                    <div class="dashboard-stat-value">
                        @Model.ActiveWorkers
                    </div>

                    <div class="dashboard-stat-description">
                        Available operational staff
                    </div>

                    <a asp-controller="Workers"
                           asp-action="Index"
                           class="dashboard-stat-link">

                        View workers

                        <span class="arrow"
                              aria-hidden="true">
                            →
                        </span>

                    </a>

                </div>

            </div>

        </div>
    }



    <!-- TOTAL VISITS -->
    <div class="@statColumnClass">

        <div class="dashboard-stat-card">

            <div class="dashboard-stat-body">

                <div class="dashboard-stat-label">
                    TOTAL VISITS
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalVisits
                </div>

                <div class="dashboard-stat-description">
                    Recorded maintenance visits
                </div>

                <a asp-controller="Visits"
                       asp-action="Index"
                       class="dashboard-stat-link">

                    View visits

                    <span class="arrow"
                          aria-hidden="true">
                        →
                    </span>

                </a>

            </div>

        </div>

    </div>

</div>



<!-- RECENT VISITS -->
<div class="app-card">

    <div class="app-card-header
        d-flex
        justify-content-between
        align-items-center">

        <strong>
            Recent Visits
        </strong>

        <a asp-controller="Visits"
               asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
            View All
        </a>

    </div>


    @if (!Model.RecentVisits.Any())
    {
        <div class="app-card-body
            text-center
            text-muted
            py-5">

            No visits have been recorded yet.

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table mb-0">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Site</th>
                        <th>Component</th>
                        <th>Purpose</th>
                        <th>Malfunction</th>
                        <th>Repair Result</th>
                        <th></th>
                    </tr>
                </thead>


                <tbody>

                    @foreach (var visit in Model.RecentVisits)
                    {
                        <tr>

                            <td>

                                <div>
                                    @(visit.VisitDate.ToString(
                                        "dd/MM/yyyy"))
                                </div>

                                <small class="text-muted">
                                    @(visit.VisitDate.ToString(
                                        "HH:mm"))
                                </small>

                            </td>


                            <td>

                                <strong>
                                    @visit.SiteName
                                </strong>

                                <div class="text-muted small">
                                    @visit.SiteId
                                </div>

                            </td>


                            <td>

                                <strong>
                                    @visit.ComponentName
                                </strong>

                                <div class="text-muted small">
                                    @visit.ComponentType
                                </div>

                            </td>


                            <td>
                                @visit.Purpose
                            </td>


                            <td>

                                @if (string.IsNullOrWhiteSpace(
                                    visit.MalfunctionType))
                                {
                                    <span class="badge
                                        bg-success-subtle
                                        text-success">
                                        None
                                    </span>
                                }
                                else
                                {
                                    @visit.MalfunctionType
                                }

                            </td>


                            <td>

                                @(string.IsNullOrWhiteSpace(
                                    visit.RepairResult)
                                    ? "—"
                                    : visit.RepairResult)

                            </td>


                            <td class="text-end">

                                <a asp-controller="Visits"
                                       asp-action="Details"
                                       asp-route-id="@visit.VisitId"
                                       class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
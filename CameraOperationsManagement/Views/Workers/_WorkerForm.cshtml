@model CameraOperationsManagement.ViewModels.Workers.WorkerFormViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger mb-4">
</div>

<div class="row g-3">

    <div class="col-md-4">

        <label asp-for="FirstName"
               class="form-label">
        </label>

        <input asp-for="FirstName"
               class="form-control"
               autocomplete="off" />

        <span asp-validation-for="FirstName"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-4">

        <label asp-for="SecondName"
               class="form-label">
        </label>

        <input asp-for="SecondName"
               class="form-control"
               autocomplete="off" />

        <span asp-validation-for="SecondName"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-4">

        <label asp-for="LastName"
               class="form-label">
        </label>

        <input asp-for="LastName"
               class="form-control"
               autocomplete="off" />

        <span asp-validation-for="LastName"
              class="text-danger">
        </span>

    </div>

</div>
@using CameraOperationsManagement.Models

@model IEnumerable<CameraOperationsManagement.ViewModels.Workers.WorkerListItemViewModel>

@{
    var canManageWorkers =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var isAdmin =
        User.IsInRole(AppRoles.Admin);
}


<div class="app-card">

    @if (!Model.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No workers were found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Worker</th>
                        <th>Status</th>

                        <th class="text-end">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var worker in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @worker.FullName
                                </strong>
                            </td>


                            <td>

                                @if (worker.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-action="History"
                                           asp-route-id="@worker.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        History
                                    </a>


                                    @if (canManageWorkers)
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@worker.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    }


                                    @if (isAdmin)
                                    {
                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@worker.Id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">

                                                @(worker.IsActive
                                                    ? "Deactivate"
                                                    : "Activate")

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
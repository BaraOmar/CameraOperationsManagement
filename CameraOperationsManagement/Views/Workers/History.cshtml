@model CameraOperationsManagement.ViewModels.Workers.WorkerHistoryViewModel

@{
    ViewData["Title"] = "Worker History";
}

<div class="page-header">
    <div class="d-flex align-items-start gap-3">

        <partial name="_BackButton" />
    <div>
        <h2 class="page-heading">
            Worker History
        </h2>

        <p class="page-description">
            Complete operational history for @Model.FullName.
        </p>
    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">
        Back to Workers
    </a>
    </div>
</div>


<!-- WORKER INFORMATION -->
<div class="app-card mb-4">

    <div class="app-card-header">
        <strong>Worker Information</strong>
    </div>

    <div class="app-card-body">

        <div class="row g-4">

            <div class="col-md-4">

                <div class="text-muted small mb-1">
                    Worker
                </div>

                <strong>
                    @Model.FullName
                </strong>

            </div>


            <div class="col-md-4">

                <div class="text-muted small mb-1">
                    Worker ID
                </div>

                <div>
                    @Model.WorkerId
                </div>

            </div>


            <div class="col-md-4">

                <div class="text-muted small mb-1">
                    Status
                </div>

                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary">
                        Inactive
                    </span>
                }

            </div>

        </div>

    </div>

</div>


<!-- VISIT HISTORY -->
<div class="mb-3">

    <h3 class="h5 mb-1">
        Visit History
    </h3>

    <p class="text-muted mb-0">
        All visits assigned to this worker, newest first.
    </p>

</div>


@if (!Model.Visits.Any())
{
    <div class="app-card">

        <div class="app-card-body text-center text-muted py-5">
            No visits have been recorded for this worker.
        </div>

    </div>
}
else
{
    <div class="d-flex flex-column gap-3">

        @foreach (var visit in Model.Visits)
        {
            <div class="app-card">

                <div class="app-card-header
                    d-flex
                    justify-content-between
                    align-items-start">

                    <div>

                        <div class="d-flex
                            align-items-center
                            gap-2
                            flex-wrap">

                            <strong>
                                @visit.ComponentName
                            </strong>

                            <span class="badge text-bg-secondary">
                                @visit.ComponentType
                            </span>

                        </div>


                        <div class="text-muted small mt-1">

                            @(visit.VisitDate.ToString(
                                "dd/MM/yyyy HH:mm"))

                            ·

                            @visit.Purpose

                        </div>

                    </div>


                    <a asp-controller="Visits"
                           asp-action="Details"
                           asp-route-id="@visit.VisitId"
                           class="btn btn-sm btn-outline-secondary">
                        View Visit
                    </a>

                </div>


                <div class="app-card-body">

                    <div class="row g-4">

                        <!-- SITE -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-2">
                                Site
                            </div>

                            <div>
                                <strong>
                                    @visit.SiteName
                                </strong>
                            </div>

                            <small class="text-muted">
                                @visit.SiteId
                            </small>

                        </div>


                        <!-- COMPONENT -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-2">
                                Component
                            </div>

                            <div>
                                <strong>
                                    @visit.ComponentName
                                </strong>
                            </div>

                            <small class="text-muted">
                                @visit.ComponentType
                            </small>

                        </div>


                        <!-- MALFUNCTION -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-2">
                                Malfunction
                            </div>

                            @if (string.IsNullOrWhiteSpace(
                                visit.MalfunctionType))
                            {
                                <span class="badge
                                    bg-success-subtle
                                    text-success">
                                    None
                                </span>
                            }
                            else
                            {
                                <div>
                                    <strong>
                                        @visit.MalfunctionType
                                    </strong>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    visit.MalfunctionDescription))
                                {
                                    <div class="text-muted mt-1">
                                        @visit.MalfunctionDescription
                                    </div>
                                }
                            }

                        </div>


                        <!-- REPAIR WORK -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-2">
                                Work Performed
                            </div>

                            <div>
                                @(visit.RepairWorkPerformed ?? "—")
                            </div>

                        </div>


                        <!-- REPAIR RESULT -->
                        <div class="col-md-6">

                            <div class="text-muted small mb-2">
                                Repair Result
                            </div>

                            <div>
                                @(visit.RepairResult ?? "—")
                            </div>

                        </div>


                        <!-- NOTES -->
                        @if (!string.IsNullOrWhiteSpace(
                            visit.Notes))
                        {
                            <div class="col-12">

                                <div class="text-muted small mb-2">
                                    Notes
                                </div>

                                <div>
                                    @visit.Notes
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}
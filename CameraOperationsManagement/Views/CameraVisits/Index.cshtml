@model IEnumerable<CameraOperationsManagement.ViewModels.CameraVisits.CameraVisitListItemViewModel>

@{
    ViewData["Title"] = "Camera Visits";
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Camera Visits
        </h2>

        <p class="page-description">
            View the operational history of camera visits,
            malfunctions, and repair results.
        </p>
    </div>

    @if (User.IsInRole("Admin") ||
         User.IsInRole("Editor"))
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Record Camera Visit
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">

            <!-- SEARCH -->
            <div class="col-lg-4 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Camera, purpose, malfunction, repair..." />

            </div>


            <!-- SITE -->
            <div class="col-lg-4 col-md-6">

                <label class="form-label">
                    Site
                </label>

                <select name="siteId"
                        asp-items="ViewBag.Sites"
                        class="form-select">

                    <option value="">
                        All sites
                    </option>

                </select>

            </div>


            <!-- CAMERA -->
            <div class="col-lg-4 col-md-6">

                <label class="form-label">
                    Camera
                </label>

                <select name="cameraId"
                        asp-items="ViewBag.FilterCameras"
                        class="form-select">

                    <option value="">
                        All cameras
                    </option>

                </select>

            </div>


            <!-- WORKER -->
            <div class="col-lg-4 col-md-6">

                <label class="form-label">
                    Worker
                </label>

                <select name="workerId"
                        asp-items="ViewBag.FilterWorkers"
                        class="form-select">

                    <option value="">
                        All workers
                    </option>

                </select>

            </div>


            <!-- FROM DATE -->
            <div class="col-lg-2 col-md-6">

                <label class="form-label">
                    From
                </label>

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control" />

            </div>


            <!-- TO DATE -->
            <div class="col-lg-2 col-md-6">

                <label class="form-label">
                    To
                </label>

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control" />

            </div>


            <!-- ACTIONS -->
            <div class="col-lg-4 col-md-12">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>
<div class="app-card">

    @if (!Model.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No camera visits have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Camera</th>
                        <th>Site / Recorder</th>
                        <th>Purpose</th>
                        <th>Malfunction</th>
                        <th>Repair Result</th>
                        <th>Workers</th>

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Editor"))
                        {
                            <th class="text-end">
                                Actions
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @foreach (var visit in Model)
                    {
                        <tr>

                            <td>
                                <div>
                                    @visit.VisitDate.ToString("dd/MM/yyyy")
                                </div>

                                <small class="text-muted">
                                    @visit.VisitDate.ToString("HH:mm")
                                </small>
                            </td>


                            <td>
                                <strong>
                                    @visit.CameraName
                                </strong>
                            </td>


                            <td>
                                <div>
                                    @visit.SiteName
                                </div>

                                <small class="text-muted">
                                    @visit.RecorderName
                                </small>
                            </td>


                            <td>
                                @visit.Purpose
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    visit.MalfunctionType))
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        None
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">
                                        @visit.MalfunctionType
                                    </span>
                                }
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    visit.RepairResult))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @visit.RepairResult
                                }
                            </td>


                            <td>
                                @if (visit.WorkerNames.Any())
                                {
                                    @string.Join(", ", visit.WorkerNames)
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                            </td>


                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Editor"))
                            {
                                <td class="text-end">
                                    <a asp-action="Details"
                                           asp-route-id="@visit.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                    <a asp-action="Edit"
                                           asp-route-id="@visit.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
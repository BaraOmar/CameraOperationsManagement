@model CameraOperationsManagement.ViewModels.CameraVisits.CameraVisitFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>


<!-- VISIT INFORMATION -->
<div class="app-card shadow-none mb-4">

    <div class="app-card-header">
        <strong>Visit Information</strong>
    </div>

    <div class="app-card-body">

        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="CameraId"
                       class="form-label">
                </label>

                <select asp-for="CameraId"
                        asp-items="ViewBag.Cameras"
                        class="form-select">

                    <option value="0">
                        Select camera
                    </option>

                </select>

                <span asp-validation-for="CameraId"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="VisitDate"
                       class="form-label">
                </label>

                <input asp-for="VisitDate"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="VisitDate"
                      class="text-danger">
                </span>

            </div>


            <div class="col-12">

                <label asp-for="Purpose"
                       class="form-label">
                </label>

                <input asp-for="Purpose"
                       class="form-control" />

                <span asp-validation-for="Purpose"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- WORKERS -->
<div class="app-card shadow-none mb-4">

    <div class="app-card-header">
        <strong>Workers</strong>
    </div>

    <div class="app-card-body">

        @{
            var workers =
                ViewBag.Workers as IEnumerable<SelectListItem>;
        }

        @if (workers == null || !workers.Any())
        {
            <div class="text-muted">
                No active workers are available.
            </div>
        }
        else
        {
            <div class="row g-2">

                @foreach (var worker in workers)
                {
                    <div class="col-md-4">

                        <div class="form-check">

                            <input type="checkbox"
                                   name="WorkerIds"
                                   value="@worker.Value"
                                   checked="@worker.Selected"
                                   class="form-check-input"
                                   id="worker_@worker.Value" />

                            <label class="form-check-label"
                                   for="worker_@worker.Value">
                                @worker.Text
                            </label>

                        </div>

                    </div>
                }

            </div>
        }

        <span asp-validation-for="WorkerIds"
              class="text-danger">
        </span>

    </div>

</div>


<!-- MALFUNCTION -->
<div class="app-card shadow-none mb-4">

    <div class="app-card-header">
        <strong>Malfunction</strong>

        <div class="text-muted small mt-1">
            Leave empty if no malfunction was found during this visit.
        </div>
    </div>

    <div class="app-card-body">

        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="MalfunctionType"
                       class="form-label">
                </label>

                <input asp-for="MalfunctionType"
                       class="form-control" />

                <span asp-validation-for="MalfunctionType"
                      class="text-danger">
                </span>

            </div>


            <div class="col-12">

                <label asp-for="MalfunctionDescription"
                       class="form-label">
                </label>

                <textarea asp-for="MalfunctionDescription"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="MalfunctionDescription"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- REPAIR -->
<div class="app-card shadow-none mb-4">

    <div class="app-card-header">
        <strong>Repair</strong>

        <div class="text-muted small mt-1">
            Record any repair work performed during this visit.
        </div>
    </div>

    <div class="app-card-body">

        <div class="row g-3">

            <div class="col-12">

                <label asp-for="RepairWorkPerformed"
                       class="form-label">
                </label>

                <textarea asp-for="RepairWorkPerformed"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="RepairWorkPerformed"
                      class="text-danger">
                </span>

            </div>


            <div class="col-12">

                <label asp-for="RepairResult"
                       class="form-label">
                </label>

                <input asp-for="RepairResult"
                       class="form-control" />

                <span asp-validation-for="RepairResult"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

</div>


<!-- NOTES -->
<div class="app-card shadow-none">

    <div class="app-card-header">
        <strong>Additional Notes</strong>
    </div>

    <div class="app-card-body">

        <label asp-for="Notes"
               class="form-label">
        </label>

        <textarea asp-for="Notes"
                  class="form-control"
                  rows="4"></textarea>

        <span asp-validation-for="Notes"
              class="text-danger">
        </span>

    </div>

</div>
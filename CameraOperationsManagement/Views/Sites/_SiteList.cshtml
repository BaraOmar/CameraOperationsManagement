@using CameraOperationsManagement.Models
@using CameraOperationsManagement.ViewModels.Common
@using CameraOperationsManagement.ViewModels.Sites

@model PagedResult<SiteListItemViewModel>

@{
    var canManageInfrastructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var canChangeStatus =
        User.IsInRole(AppRoles.Admin);

    var currentSearch =
        Context.Request.Query["search"].ToString();

    var currentLocation =
        Context.Request.Query["location"].ToString();

    var currentStatus =
        Context.Request.Query["status"].ToString();
}


<div class="app-card">

    @if (!Model.Items.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No sites were found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Site ID</th>
                        <th>Site Name</th>
                        <th>Location</th>
                        <th>Status</th>

                        <th class="text-end">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var site in Model.Items)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @site.Id
                                </strong>
                            </td>


                            <td>
                                @site.Name
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    site.Location))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @site.Location
                                }
                            </td>


                            <td>
                                @if (site.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>


                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-action="Structure"
                                           asp-route-id="@site.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>


                                    <a asp-action="History"
                                           asp-route-id="@site.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        History
                                    </a>


                                    @if (canManageInfrastructure)
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@site.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    }


                                    @if (canChangeStatus)
                                    {
                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@site.Id"
                                              method="post">

                                            @if (site.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Activate
                                                </button>
                                            }

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>


@if (Model.TotalPages > 1)
{
    <div class="d-flex
        justify-content-between
        align-items-center
        mt-3">

        <div class="text-muted small">
            Showing page
            @Model.Page
            of
            @Model.TotalPages
            —
            @Model.TotalItems
            total records
        </div>


        <nav aria-label="Site pagination">

            <ul class="pagination mb-0">


                <li class="page-item
                    @(Model.HasPreviousPage
                                            ? ""
                                            : "disabled")">

                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link"
                               data-page-link
                               asp-action="Index"
                               asp-route-search="@currentSearch"
                               asp-route-location="@currentLocation"
                               asp-route-status="@currentStatus"
                               asp-route-page="@(Model.Page - 1)">
                            Previous
                        </a>
                    }
                    else
                    {
                        <span class="page-link">
                            Previous
                        </span>
                    }

                </li>


                @for (var i = 1;
                      i <= Model.TotalPages;
                      i++)
                {
                    <li class="page-item
                        @(i == Model.Page
                                                    ? "active"
                                                    : "")">

                        <a class="page-link"
                               data-page-link
                               asp-action="Index"
                               asp-route-search="@currentSearch"
                               asp-route-location="@currentLocation"
                               asp-route-status="@currentStatus"
                               asp-route-page="@i">
                            @i
                        </a>

                    </li>
                }


                <li class="page-item
                    @(Model.HasNextPage
                                            ? ""
                                            : "disabled")">

                    @if (Model.HasNextPage)
                    {
                        <a class="page-link"
                               data-page-link
                               asp-action="Index"
                               asp-route-search="@currentSearch"
                               asp-route-location="@currentLocation"
                               asp-route-status="@currentStatus"
                               asp-route-page="@(Model.Page + 1)">
                            Next
                        </a>
                    }
                    else
                    {
                        <span class="page-link">
                            Next
                        </span>
                    }

                </li>

            </ul>

        </nav>

    </div>
}
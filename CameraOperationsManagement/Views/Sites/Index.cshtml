@using CameraOperationsManagement.Models
@model IEnumerable<CameraOperationsManagement.ViewModels.Sites.SiteListItemViewModel>

@{
    ViewData["Title"] = "Sites";

    var canManageInfrastructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var canChangeStatus =
        User.IsInRole(AppRoles.Admin);

    var canViewStructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager) ||
        User.IsInRole(AppRoles.Editor) ||
        User.IsInRole(AppRoles.InfrastructureViewer);
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Sites
        </h2>

        <p class="page-description">
            View and manage operational sites.
        </p>
    </div>

    @if (canManageInfrastructure)
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Add Site
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<form method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">

            <!-- SEARCH -->
            <div class="col-lg-5 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Site ID, name, location..." />

            </div>


            <!-- LOCATION -->
            <div class="col-lg-3 col-md-6">

                <label class="form-label">
                    Location
                </label>

                <select name="location"
                        asp-items="ViewBag.Locations"
                        class="form-select">

                    <option value="">
                        All locations
                    </option>

                </select>

            </div>


            <!-- STATUS -->
            <div class="col-lg-2 col-md-6">

                <label class="form-label">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Status == null)">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(ViewBag.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(ViewBag.Status == "inactive")">
                        Inactive
                    </option>

                </select>

            </div>


            <!-- FILTER ACTIONS -->
            <div class="col-lg-2 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply
                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>


<div class="app-card">

    @if (!Model.Any())
    {
        <div class="app-card-body text-center text-muted py-5">
            No sites have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Site ID</th>
                        <th>Site Name</th>
                        <th>Location</th>
                        <th>Status</th>

                        <th class="text-end">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var site in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @site.Id
                                </strong>
                            </td>


                            <td>
                                @site.Name
                            </td>


                            <td>
                                @if (string.IsNullOrWhiteSpace(site.Location))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @site.Location
                                }
                            </td>


                            <td>
                                @if (site.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>


                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <!--
                                        Full infrastructure view.
                                        Basic Viewer must not see
                                        Recorders/Cameras/Switches.
                                    -->
                                    <a asp-action="Structure"
                                           asp-route-id="@site.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>


                                    <!-- Available to all five roles -->
                                    <a asp-action="History"
                                           asp-route-id="@site.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        History
                                    </a>


                                    <!-- Admin + Infrastructure Manager -->
                                    @if (canManageInfrastructure)
                                    {
                                        <a asp-action="Edit"
                                               asp-route-id="@site.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    }


                                    <!-- Admin only -->
                                    @if (canChangeStatus)
                                    {
                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@site.Id"
                                              method="post">

                                            @if (site.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Activate
                                                </button>
                                            }

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
@using CameraOperationsManagement.Models
@using CameraOperationsManagement.ViewModels.Common
@using CameraOperationsManagement.ViewModels.Sites

@model PagedResult<SiteListItemViewModel>

@{
    ViewData["Title"] = "Sites";

    var canManageInfrastructure =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.InfrastructureManager);

    var canChangeStatus =
        User.IsInRole(AppRoles.Admin);
}

<div class="page-header">

    <div>
        <h2 class="page-heading">
            Sites
        </h2>

        <p class="page-description">
            View and manage operational sites.
        </p>
    </div>

    @if (canManageInfrastructure)
    {
        <a asp-action="Create"
               class="btn btn-primary">
            Add Site
        </a>
    }

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<form id="siteFilterForm"
      method="get"
      asp-action="Index"
      class="app-card mb-4">

    <div class="app-card-body">

        <div class="row g-3 align-items-end">

            <div class="col-lg-5 col-md-6">

                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Site ID, name, location..." />

            </div>


            <div class="col-lg-3 col-md-6">

                <label class="form-label">
                    Location
                </label>

                <select name="location"
                        asp-items="ViewBag.Locations"
                        class="form-select">

                    <option value="">
                        All locations
                    </option>

                </select>

            </div>


            <div class="col-lg-2 col-md-6">

                <label class="form-label">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value=""
                            selected="@(ViewBag.Status == null)">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(ViewBag.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(ViewBag.Status == "inactive")">
                        Inactive
                    </option>

                </select>

            </div>


            <div class="col-lg-2 col-md-6">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Apply
                    </button>

                    <button type="button"
                            id="clearSiteFilters"
                            class="btn btn-outline-secondary">
                        Clear
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>


<div id="siteListContainer">

    <partial name="_SiteList"
             model="Model" />

</div>


@section Scripts
{
    <script>
        (() => {

            const form =
                document.getElementById("siteFilterForm");

            const container =
                document.getElementById("siteListContainer");

            const clearButton =
                document.getElementById("clearSiteFilters");


            async function loadSites(url) {

                try {

                    const response =
                        await fetch(url, {
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        });


                    if (!response.ok) {
                        throw new Error(
                            "Failed to load sites.");
                    }


                    const html =
                        await response.text();


                    container.innerHTML =
                        html;


                    window.history.pushState(
                        {},
                        "",
                        url);

                }
                catch (error) {

                    console.error(error);

                }
            }


            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();


                    const formData =
                        new FormData(form);


                    formData.set(
                        "page",
                        "1");


                    const query =
                        new URLSearchParams(
                            formData);


                    const url =
                        `${form.action}?${query.toString()}`;


                    loadSites(url);
                });


            clearButton.addEventListener(
                "click",
                function () {

                    form.reset();

                    loadSites(form.action);
                });


            container.addEventListener(
                "click",
                function (event) {

                    const link =
                        event.target.closest(
                            "a[data-page-link]");


                    if (!link) {
                        return;
                    }


                    event.preventDefault();


                    loadSites(
                        link.href);
                });


            window.addEventListener(
                "popstate",
                function () {

                    window.location.reload();

                });

        })();
    </script>
}
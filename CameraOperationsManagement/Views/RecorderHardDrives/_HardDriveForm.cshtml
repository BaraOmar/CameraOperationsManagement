@model CameraOperationsManagement.ViewModels.RecorderHardDrives.RecorderHardDriveFormViewModel

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<div class="row g-3">

    <div class="col-md-6">

        <label asp-for="CapacityGb"
               class="form-label">
        </label>

        <input asp-for="CapacityGb"
               class="form-control"
               type="number"
               min="1" />

        <span asp-validation-for="CapacityGb"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="SerialNumber"
               class="form-label">
        </label>

        <input asp-for="SerialNumber"
               class="form-control"
               autocomplete="off" />

        <span asp-validation-for="SerialNumber"
              class="text-danger">
        </span>

    </div>

</div>